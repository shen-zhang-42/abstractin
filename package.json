{
	"name": "abstractin",
	"private": true,
	"version": "0.2.131",
	"description": "AbstractIn: skill-driven reading of books and scientific papers in Zotero with local Codex.",
	"type": "module",
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"build": "bash build.sh",
		"shots": "bash test/screenshots.sh",
		"test:zotero": "bash test/integration/run.sh",
		"videos": "bash test/videos/zotero/record.sh",
		"source:path": "node scripts/source-path.mjs"
	},
	"devDependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.14",
		"@tiptap/core": "3.33.1",
		"@tiptap/extension-image": "3.33.1",
		"@tiptap/extension-mathematics": "3.33.1",
		"@tiptap/extension-paragraph": "3.33.1",
		"@tiptap/extension-table": "3.33.1",
		"@tiptap/extension-task-item": "3.33.1",
		"@tiptap/extension-task-list": "3.33.1",
		"@tiptap/markdown": "3.33.1",
		"@tiptap/starter-kit": "3.33.1",
		"esbuild": "0.28.2",
		"jsdom": "^26.1.0"
	}
}
